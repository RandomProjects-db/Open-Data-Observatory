<?php

/**
 * @file
 * Hooks for the ODO Core module.
 */

declare(strict_types=1);

use Drupal\Component\Serialization\Json;
use Drupal\Core\Render\Markup;
use Drupal\Core\Site\Settings;
use Drupal\node\NodeInterface;

/**
 * Implements hook_page_attachments().
 *
 * Adds the Google tag (Tag Manager container) on public pages when
 * $settings['odo_gtm_id'] is set in settings.php. Only production sets it,
 * so staging and local copies never send analytics.
 *
 * Consent mode defaults to "denied"; js/consent.js asks the visitor and
 * updates consent. Without consent, no analytics cookies are set.
 */
function odo_core_page_attachments(array &$attachments): void {
  $attachments['#cache']['tags'][] = 'config:system.site';
  $attachments['#cache']['contexts'][] = 'route';

  $id = (string) Settings::get('odo_gtm_id', '');
  // SECURITY: the ID is printed into a script; accept only the documented
  // formats so a bad settings value cannot inject markup.
  if (!preg_match('/^(GTM|G)-[A-Z0-9]{4,12}$/', $id)) {
    return;
  }
  if (\Drupal::service('router.admin_context')->isAdminRoute()) {
    return;
  }

  // Page context for analytics dimensions (no personal data).
  $page = ['content_type' => 'page'];
  $node = \Drupal::routeMatch()->getParameter('node');
  if ($node instanceof NodeInterface) {
    $page['content_type'] = $node->bundle();
    foreach (['field_topic' => 'topic', 'field_region' => 'region'] as $field => $key) {
      if ($node->hasField($field) && !$node->get($field)->isEmpty()) {
        $page[$key] = (string) $node->get($field)->entity?->label();
      }
    }
  }

  $init = 'window.dataLayer = window.dataLayer || [];'
    . 'function gtag(){dataLayer.push(arguments);}'
    . "gtag('consent','default',{analytics_storage:'denied',ad_storage:'denied',ad_user_data:'denied',ad_personalization:'denied'});"
    . "try{if(localStorage.getItem('odo_consent')==='granted'){gtag('consent','update',{analytics_storage:'granted'});}}catch(e){}"
    . "gtag('js',new Date());"
    . 'dataLayer.push(' . Json::encode($page) . ');';

  $attachments['#attached']['html_head'][] = [
    ['#type' => 'html_tag', '#tag' => 'script', '#value' => Markup::create($init), '#weight' => -100],
    'odo_gtag_init',
  ];
  $attachments['#attached']['html_head'][] = [
    [
      '#type' => 'html_tag',
      '#tag' => 'script',
      '#attributes' => ['async' => TRUE, 'src' => 'https://www.googletagmanager.com/gtm.js?id=' . $id],
      '#weight' => -99,
    ],
    'odo_gtag_src',
  ];
  $attachments['#attached']['library'][] = 'odo_core/consent';
}
