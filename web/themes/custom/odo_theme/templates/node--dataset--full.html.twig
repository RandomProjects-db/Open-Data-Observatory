{#
/**
 * @file
 * Full view of a Dataset: summary, chart and an accessible data table.
 *
 * The table is the accessible source of truth; the SVG chart is drawn by
 * js/dataset-chart.js from the same series JSON.
 */
#}
{{ attach_library('odo_theme/dataset-chart') }}
<article{{ attributes.addClass('node', 'node--type-dataset', 'node--view-mode-full') }}>
  <div{{ content_attributes.addClass('node__content') }}>
    {{ content.body }}

    <div class="odo-facts">
      {{ content.field_latest_value }}
      {{ content.field_latest_year }}
      {{ content.field_country_code }}
      {{ content.field_indicator_code }}
      {{ content.field_region }}
      {{ content.field_topic }}
    </div>

    {% if series is iterable and series|length > 1 %}
      <figure class="odo-chart" data-series="{{ series_json }}">
        <figcaption>{{ label }}</figcaption>
        <div class="odo-chart__plot"></div>
        <details>
          <summary>{{ 'Data table'|t }}</summary>
          <table class="odo-data-table">
            <caption class="visually-hidden">{{ label }}, {{ 'values by year'|t }}</caption>
            <thead><tr><th scope="col">{{ 'Year'|t }}</th><th scope="col">{{ 'Value'|t }}</th></tr></thead>
            <tbody>
              {% for year, value in series %}
                <tr><th scope="row">{{ year }}</th><td>{{ value|number_format(2) }}</td></tr>
              {% endfor %}
            </tbody>
          </table>
        </details>
      </figure>
    {% endif %}

    {{ content.field_source_url }}
  </div>
</article>
