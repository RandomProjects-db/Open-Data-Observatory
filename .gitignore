# Installed by Composer; rebuilt from composer.lock
/vendor/
/web/core/
/web/modules/contrib/
/web/themes/contrib/
/web/profiles/contrib/
/web/libraries/
/recipes/

# SECURITY: contains database credentials and hash salt
/web/sites/*/settings.php
/web/sites/*/settings.local.php
/web/sites/*/services.yml

# User uploads and private files
/web/sites/*/files/
/private/

# Environment and secrets
.env
*.env

# Raw Lighthouse output (several MB); summaries are committed
docs/reports/lighthouse/**/*.json

# Environment-specific Drush site URI
/drush/drush.yml

# Private planning notes (not published)
/PLAN.md
/REMAINING.md
